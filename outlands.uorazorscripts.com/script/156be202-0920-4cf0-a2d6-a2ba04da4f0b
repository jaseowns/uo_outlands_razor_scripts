            if not hidden
                @setvar! Stealthing 0
                @setvar! StealthingReady 0
                @setvar! KeepOnTrucking 0
                hotkey 'Toggle War Only'
                break
            endif

            if hidden and not cooldown 'Hiding'
                @setvar! StealthingReady 1
            endif
        endif
    endwhile

    ///////////////////////////////////
    //  END WAITING FOR STEALTH LOOP //
    ///////////////////////////////////

    @setvar! TargetAcquired 0
    getlabel backpack backpacklabel
    clearsysmsg 
    
    /////////////////////
    //  STEALTH LOOP:  //
    /////////////////////

    while hidden and StealthingReady = 1 and TargetAcquired != 1
        if EnableWizardHatStealthTrick = 1
            if find MagicWizardHat backpack and find MyHelmet self
                if hidden and stam = maxstam
                    if EnableOverheadMessages = 1
                        overhead '[ HAT TRICK ]' 111
                    endif
