// Set variables, timers and lists
setvar! breedHue 2642
setvar! breedGumpID 1942558613
setvar! breedWait 500
setvar! breedRefillStarted 0

setvar! breedWaitForObjectDelay 600
settimer breedObjectDelayTimer breedWaitForObjectDelay

setvar! breedOverheadCD 3000
settimer breedOverheadTimer breedOverheadCD

setvar! cRed          33
setvar! cYellow       55
setvar! cGreen        68
setvar! cLightBlue   100
setvar! cLightOrange 145

removelist breedTroughList
createlist breedTroughList
removelist breedCheckedList
createlist breedCheckedList

// User input validation
if breedScanRange = 1 or breedScanRange = 2 or breedScanRange = 3 or breedScanRange = 4 or breedScanRange = 5 or breedScanRange = 6 or breedScanRange = 7 or breedScanRange = 8 or breedScanRange = 9 or breedScanRange = 10 or breedScanRange = 11 or breedScanRange = 12 or breedScanRange = 13 or breedScanRange = 14 or breedScanRange = 15 or breedScanRange = 16 or breedScanRange = 17 or breedScanRange = 18
    // Valid
else
    setvar! breedScanRange 18
    overhead "|* ScanRange invalid *|" cRed
    overhead "|* Setting default: {{breedScanRange}} *|" cYellow
endif

if breedUseRange = 1 or breedUseRange = 2 or breedUseRange = 3 or breedUseRange = 4
    // Valid
else
    setvar! breedUseRange 2
    overhead "|* UseRange invalid *|" cRed
    overhead "|* Setting default: {{breedUseRange}} *|" cYellow
endif

if breedScanRange = 1 and breedUseRange > 1
    setvar! breedUseRange 1
elseif breedScanRange = 2 and breedUseRange > 2
    setvar! breedUseRange 2
elseif breedScanRange = 3 and breedUseRange > 3
    setvar! breedUseRange 3
endif

if breedShowInactiveTrough = 0 or breedShowInactiveTrough = 1
    // Valid
else
    setvar! breedShowInactiveTrough 1
    overhead "|* ShowInactiveTrough invalid *|" cRed
    overhead "|* Setting default: {{breedShowInactiveTrough}} *|" cYellow      
endif

if breedAutoAddFertilitySerum = 0 or breedAutoAddFertilitySerum = 1
    // Valid
else
    setvar! breedAutoAddFertilitySerum 0
    overhead "|* AutoAddFertilitySerum invalid *|" cRed
    overhead "|* Setting default: {{breedAutoAddFertilitySerum}} *|" cYellow
endif

if breedAutoAddGrowthTablets = 0 or breedAutoAddGrowthTablets = 1
    // Valid
else
    setvar! breedAutoAddGrowthTablets 0
    overhead "|* AutoAddGrowthTablets invalid *|" cRed
    overhead "|* Setting default: {{breedAutoAddGrowthTablets}} *|" cYellow    
endif

if breedShowOverheadInfo = 0 or breedShowOverheadInfo = 1
    // Valid
else
    setvar! breedShowOverheadInfo 0
    overhead "|* ShowOverheadInfo invalid *|" cRed
    overhead "|* Setting default: {{breedShowOverheadInfo}} *|" cYellow        
endif

if breedMaxAspectCharges = 0 or breedMaxAspectCharges = 1 or breedMaxAspectCharges = 2 or breedMaxAspectCharges = 3 or breedMaxAspectCharges = 4 or breedMaxAspectCharges = 5 or breedMaxAspectCharges = 6
    // Valid
    if breedAllowMixedHorseBodies = 0 or breedAllowMixedHorseBodies = 1
        // Valid
    else
        setvar! breedAllowMixedHorseBodies 0
        overhead "|* AllowMixedHorseBodies invalid *|" cRed
        overhead "|* Setting default: {{breedAllowMixedHorseBodies}} *|" cYellow        
    endif
else
    setvar! breedMaxAspectCharges 0
    overhead "|* MaxAspectCharges invalid *|" cRed
    overhead "|* Setting default: {{breedMaxAspectCharges}} *|" cYellow
endif

// Start breeding
@clearignore
if targetexists
    target cancel
endif
overhead "|* Breeding Started *|" cGreen

if find breedSupplyContainer ground -1 -1 2 and not findtype 3703|3707|3715|4090|5344|5453|25570|56416|56417|2452|2485|2512|2513|2514|2544|3164|3173|3174|3178|3181|3184|3186|3188|3191|3195|3199|3350|3386|5919|5923|5928|5930|20499|20500|20498|29030 breedSupplyContainer
    dclick breedSupplyContainer
    wait breedWaitForObjectDelay
endif

while findtype "feeder trough" ground -1 -1 breedScanRange
    
    setvar! breedCurrentTrough 0

    // Select trough
    if not findtype "feeder trough" ground -1 -1 breedUseRange

        if timer breedOverheadTimer > breedOverheadCD
            overhead "|* Searching feeding trough *|" cGreen
            clearlist breedTroughList
            while breedShowOverheadInfo = 1 and 10 > index and findtype "feeder trough" ground -1 -1 breedScanRange as localBreeder
                overhead "Pending" cLightOrange localBreeder
                overhead "   ¼   " cLightOrange localBreeder
                pushlist breedTroughList localBreeder
                @ignore localBreeder
            endwhile
            @unignore breedTroughList
            clearlist breedTroughList
            clearlist breedCheckedList
            settimer breedOverheadTimer 0
        endif
        wait 250
        continue
    
    elseif breedShowInactiveTrough = 0 and findtype "feeder trough" ground -1 -1 breedUseRange as localBreeder

        setvar! breedCurrentTrough localBreeder
        
    else

        @ignore breedTroughList
        while findtype "feeder trough" ground -1 -1 breedUseRange as localBreeder
            if not inlist breedCheckedList localBreeder
                getlabel localBreeder localBreederLabel
                if "progress: 100.00%)" in localBreederLabel or "progress: 0.00%)" in localBreederLabel
                    pushlist breedTroughList localBreeder front
                    setvar! breedRefillStarted 0
                else 
                    pushlist breedTroughList localBreeder back
                    pushlist breedCheckedList localBreeder
                endif
            else
                pushlist breedTroughList localBreeder back
            endif
            @ignore localBreeder
        endwhile
        @unignore breedTroughList

        if list breedTroughList = 0
            continue
        elseif poplist breedTroughList front as localBreeder
            setvar! breedCurrentTrough localBreeder
        endif

    endif

    gumpclose breedGumpID
    
    // (Re)Start inactive troughs
    if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
    endif

    while breedShowInactiveTrough = 1 and not inlist breedCheckedList breedCurrentTrough and find breedCurrentTrough ground -1 -1 breedUseRange
        
        if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
            if breedShowOverheadInfo = 1
                overhead "No line of sight" cRed breedCurrentTrough
                overhead "       ¼        " cRed breedCurrentTrough
            endif
            @ignore breedCurrentTrough
            break            
        elseif gumpexists breedGumpID and ingump "/1,000" 1942558613
            // Skip already working trough
            pushlist breedCheckedList breedCurrentTrough
            if list breedTroughList = 0
            elseif poplist breedTroughList front as localNextTrough
                pushlist breedTroughList localNextTrough front
                if not inlist breedCheckedList localNextTrough
                    pushlist breedTroughList breedCurrentTrough back
                endif
            endif
            break
        elseif not gumpexists breedGumpID
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick breedCurrentTrough
            settimer breedObjectDelayTimer 0
            waitforgump breedGumpID breedWait
            continue
        endif
        // Wait for user input
        settimer breedOverheadTimer breedOverheadCD
        while find breedCurrentTrough ground -1 -1 breedUseRange
            if ingump "/1,000" 1942558613
                pushlist breedCheckedList breedCurrentTrough
                if list breedTroughList = 0
                elseif poplist breedTroughList front as localNextTrough
                    pushlist breedTroughList localNextTrough front
                    if not inlist breedCheckedList localNextTrough
                        pushlist breedTroughList breedCurrentTrough back
                    endif
                endif
                break
            elseif not gumpexists breedGumpID
                waitforgump breedGumpID breedWait
                if not gumpexists breedGumpID
                    @ignore breedCurrentTrough
                    break
                endif
            endif
            if gumpexists breedGumpID and timer breedOverheadTimer > breedOverheadCD
                if ingump "Daily Growth" 1942558613
                    // Can be started
                    overhead "Start breeding," cGreen
                    if breedShowOverheadInfo = 1
                        overhead "  Ready  "  cGreen breedCurrentTrough
                        overhead "    ¼    " cGreen breedCurrentTrough
                    endif                    
                elseif ingump "Offspring" 1942558613
                    // Breeding finished
                    overhead "Breeding finished, restart" cGreen
                    if breedShowOverheadInfo = 1
                        overhead "Finished"  cGreen breedCurrentTrough
                        overhead "    ¼    " cGreen breedCurrentTrough
                    endif
                elseif ingump "Fertility" 1942558613
                    // One animal missing
                    overhead "Add another mount," cGreen
                    if breedShowOverheadInfo = 1
                        overhead "Add mount" cGreen breedCurrentTrough
                        overhead "    ¼    " cGreen breedCurrentTrough
                    endif
                else
                    // Both animals missing
                    overhead "Add mounts," cGreen
                    if breedShowOverheadInfo = 1
                        overhead "Add mount" cGreen breedCurrentTrough
                        overhead "    ¼    " cGreen breedCurrentTrough
                    endif                    
                endif
                overhead "or close gump to cancel" cYellow
                settimer breedOverheadTimer 0
            endif
            wait 100
        endwhile
        break

    endwhile
    
    if inlist breedTroughList breedCurrentTrough or not find breedCurrentTrough ground -1 -1 breedUseRange
        // Handle troughs requiring user input first
        continue
    endif
    
    if breedRefillStarted = 0
        overhead "|* Refilling troughs *|" cGreen
        setvar! breedRefillStarted 1
    else
        overhead "|* Next trough *|" cGreen
    endif
    target cancel

    // Add aspect items
    if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
    endif
    removelist breedAspectCountList

    while breedMaxAspectCharges != 0 and find breedCurrentTrough ground -1 -1 breedUseRange

        if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
            if breedShowOverheadInfo = 1
                overhead "No line of sight" cRed breedCurrentTrough
                overhead "       ¼        " cRed breedCurrentTrough
            endif
            @ignore breedCurrentTrough
            break
        elseif gumpexists breedGumpID and not ingump "/1,000" 1942558613
            // Skip inactive trough
            @ignore breedCurrentTrough
            break
        elseif not findtype "aspect core|flask|phylactery" backpack and not findtype "aspect core|flask|phylactery" breedSupplyContainer
            break
        elseif not gumpexists breedGumpID
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick breedCurrentTrough
            settimer breedObjectDelayTimer 0
            waitforgump breedGumpID breedWait
            continue
        elseif ingump "(x6)" 1942558613
            break
        elseif not listexists breedAspectCountList
            createlist breedAspectCountList
            if ingump "(x1)" 1942558613
                pushlist breedAspectCountList 1
            elseif ingump "(x2)" 1942558613
                pushlist breedAspectCountList 1
                pushlist breedAspectCountList 1
            elseif ingump "(x3)" 1942558613
                pushlist breedAspectCountList 1
                pushlist breedAspectCountList 1
                pushlist breedAspectCountList 1
            elseif ingump "(x4)" 1942558613
                for 4
                    pushlist breedAspectCountList 1
                endfor
            elseif ingump "(x5)" 1942558613
                for 5
                    pushlist breedAspectCountList 1
                endfor
            endif
            continue
        elseif list breedAspectCountList >= breedMaxAspectCharges
            break
        endif

        pushlist breedAspectCountList 1
        if list breedAspectCountList = breedMaxAspectCharges and not findtype "phylactery" backpack and not findtype "phylactery" breedSupplyContainer
            break
        endif
        poplist breedAspectCountList back

        setvar! breedAspectCoreHue 9999

        if ingump "Agorawave  (" 1942558613
            setvar! breedAspectCoreHue 4221
            setvar! breedAspectDistHue 4221
            setvar! breedAspectPhylHue 4221
        elseif ingump "Air  (" 1942558613
