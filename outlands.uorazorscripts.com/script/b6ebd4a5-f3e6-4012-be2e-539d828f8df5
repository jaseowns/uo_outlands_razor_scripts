# Automation by Jaseowns
## Script: Hiding & Stealth Train Together
## Created by: aplayercorpse#0
#############################################

@setvar! maxHideSkill 100
@setvar! maxStealthSkill 100
#hidingGate value targets for min. Hiding skill for using Stealth
@setvar! hidingGate 80

while skill 'Stealth' < maxStealthSkill or skill 'Hiding' < maxHideSkill

    if not hidden or skill 'Hiding' < maxHideSkill
        skill 'Hiding'
    wait 10000
    endif
    
    if hidden and skill 'Hiding' => hidingGate and skill 'Stealth' <= maxStealthSkill
        skill 'Stealth'
        wait 10000
    endif
    
    overhead 'Loop Completed'
    
endwhile