# Automation by Jaseowns
## Script: Auto Taming & Release Script
## Created by: gitbasimdan#0
#############################################

clearsysmsg 

// Prompts to select a new animal on every start
overhead 'Select animal to tame!' 15
@setvar! tameTarget 

while not dead
    // Use herding crook
    if findtype 3713 backpack as herd
        dclick herd
    endif

    // Try taming if animal is not tamed yet
    if followers == 0
        if not cooldown 'taming'
            if find tameTarget ground -1 -1 10
                menu tameTarget 1
                pause 600
                cooldown 'taming' 13000
            else
                overhead 'Animal out of range, move closer...' 34
                pause 1000
            endif
        endif
    endif

    // Release animal if tamed
    if followers > 0
        overhead 'Releasing animal...' 68
        menu tameTarget 9
        
        waitforgump 2426193729 2000
        gumpresponse 1
        
        pause 1000
    endif

    pause 300
endwhile