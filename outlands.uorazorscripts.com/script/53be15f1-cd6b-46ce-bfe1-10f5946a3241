# Automation by Jaseowns
## Script: Auto Codex Change Snippets
## Created by: barryroser#0
#############################################

# Codex Change Snippets
#
# These snippets can be used in echo change scripts/standalone button scripts
# User must edit the line in each snippet that handles your custom loadout name 
# Default loadout name is "LOADOUT NAME HERE"
#
##########################################################################
# Potion Codex

if findtype "potion codex" backpack as potcodex
    clearsysmsg 
    dclick potcodex
    waitforgump 2571832515 500
    while not ingump "LOADOUT NAME HERE"
        gumpresponse 3 2571832515
        waitforgump 2571832515 500
    endwhile
    gumpresponse 7 2571832515
    getlabel backpack ping
    if insysmsg "You must wait another"
        overhead "Codex Reset Cooling Down..." 38
        gumpclose 2571832515
    elseif insysmsg "Click again to activate this loadout"
        gumpresponse 7 2571832515
        waitforgump 2571832515 500
        gumpclose 2571832515
        cooldown "Potion Codex Reset" 300000
    endif
endif

##########################################################################
# Wizard Grimoire

if findtype "wizards grimoire" backpack as wizgrim
    clearsysmsg 
    dclick wizgrim
    waitforgump 1281623709 500
    while not ingump "LOADOUT NAME HERE"
        gumpresponse 3 1281623709
        waitforgump 1281623709 500
    endwhile
    gumpresponse 7 1281623709
    getlabel backpack ping
    if insysmsg "You must wait another"
        overhead "Codex Reset Cooling Down..." 38
        gumpclose 1281623709
        stop
    elseif insysmsg "This is already your current loadout"
        overhead "Echo Change Complete!" 88
        overhead 'Deathmage Enabled' 77
        stop
    elseif insysmsg "Click again to activate this loadout"
        gumpresponse 7 1281623709
        waitforgump 1281623709 500
        gumpclose 1281623709
        cooldown "Wizard Grimoire Reset" 300000
    endif
endif

