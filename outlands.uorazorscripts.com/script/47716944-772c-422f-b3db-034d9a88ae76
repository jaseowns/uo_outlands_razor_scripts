                    else
                        settimer HarmTimer HarmCooldown
                    endif
                endif
            endif

            if EnableCastFireball = 1 and timer FireballTimer > FireballCooldown and diffhits < CastGreaterHealHPdiff and mana >= 9 and mana < CastSmallSpellsBelowMana and not dead ClosestTarget and find ClosestTarget ground -1 -1 TargetAttackRange and findtype 3962 self
                cast 'fireball'
                settimer AntiStallTimer 0

                while not targetexists and timer AntiStallTimer < 1500
                    if dead ClosestTarget or not find ClosestTarget ground -1 -1 TargetAttackRange
                        interrupt
                        @setvar! AttackModeActive 0
                        @setvar! RepeatCastingPoison 0
                        @setvar! CastingWasInterrupted 1
                        @setvar! ClosestTargetisSticky 0
                        @setvar! TargetSwap 0
                        break
                    endif

                    if insysmsg "Your concentration is disturbed"
                        interrupt
                        @setvar! CastingWasInterrupted 1
                        break
                    endif

                    if timer AntiStallTimer > 1500
                        settimer AntiStallTimer 0
                        break
                    endif
                endwhile

                if dead ClosestTarget or not find ClosestTarget ground -1 -1 TargetAttackRange
                    break
                endif

                if CastingWasInterrupted = 0
                    clearsysmsg 
                    target ClosestTarget
                    getlabel backpack packdesc
                    wait 250

                    if insysmsg "wizardry"
                        settimer FireballTimer 0
                    elseif insysmsg "cannot be seen"
                        break
                    else
                        settimer FireballTimer FireballCooldown
                    endif
                endif
            endif

            if EnableCastLightning = 1 and timer LightningTimer > LightningCooldown and diffhits < CastGreaterHealHPdiff and mana >= 11 and mana < CastSmallSpellsBelowMana and not dead ClosestTarget and find ClosestTarget ground -1 -1 TargetAttackRange and findtype 3974 self and findtype 3980 self
                cast 'lightning'
                settimer AntiStallTimer 0
                settimer spellTimer 0
                @setvar! SpellcastCooldown 800

                while not targetexists and timer AntiStallTimer < 1500
                    if diffhits >= CastGreaterHealHPdiff
                        interrupt
                        @setvar! AttackModeActive 1
                        @setvar! CastingWasInterrupted 1
                    endif

                    if dead ClosestTarget or not find ClosestTarget ground -1 -1 TargetAttackRange
                        interrupt
                        @setvar! AttackModeActive 0
                        @setvar! RepeatCastingPoison 0
                        @setvar! CastingWasInterrupted 1
                        @setvar! ClosestTargetisSticky 0
                        @setvar! TargetSwap 0
