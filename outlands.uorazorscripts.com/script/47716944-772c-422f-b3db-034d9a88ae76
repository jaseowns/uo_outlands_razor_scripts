        @setvar! AttackModeActive 1
        // Skip target check and jump to attack loop if ClosestTarget is alive and within attack range

    elseif not dead TargetToAnalyze and find TargetToAnalyze ground -1 -1 12 and AttackModeActive = 2
        @setvar! AttackModeActive 0
        // Proceed to target checks if TargetToAnalyze is alive and within targeting range
        
    else 
