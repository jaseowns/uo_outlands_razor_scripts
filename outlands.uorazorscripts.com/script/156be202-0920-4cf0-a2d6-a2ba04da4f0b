            if insysmsg 'You have been revealed'
                if EnableOverheadMessages = 1
                    overhead '[ !! REVEALED !! ]' 153
                else 
                    overhead '!! Ï !!' 153
                endif
                clearsysmsg 
                hotkey 'Toggle War Only' 
                @setvar! Stealthing 0
                @setvar! StealthingReady 0
                @setvar! KeepOnTrucking 0
                cooldown 'Hiding' 5000
                break
