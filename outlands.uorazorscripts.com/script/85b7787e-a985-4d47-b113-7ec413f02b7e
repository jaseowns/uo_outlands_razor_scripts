                    setvar! breedAspectCoreHue 1428
                    setvar! breedAspectDistHue 1782
                    setvar! breedAspectPhylHue 1428
                elseif "Death" in breedAspectName or "death" in breedAspectName
                    setvar! breedAspectCoreHue 2155
                    setvar! breedAspectDistHue 2155
                    setvar! breedAspectPhylHue 2155
                elseif "Discipline" in breedAspectName or "discipline" in breedAspectName
                    setvar! breedAspectCoreHue 2490
                    setvar! breedAspectDistHue 2490
                    setvar! breedAspectPhylHue 2490
                elseif "Earth" in breedAspectName or "earth" in breedAspectName
                    setvar! breedAspectCoreHue 2767
                    setvar! breedAspectDistHue 2767
                    setvar! breedAspectPhylHue 2767
                elseif "Eldritch" in breedAspectName or "eldritch" in breedAspectName
                    setvar! breedAspectCoreHue 2618
                    setvar! breedAspectDistHue 2615
                    setvar! breedAspectPhylHue 2618
                elseif "Fire" in breedAspectName or "fire" in breedAspectName
                    setvar! breedAspectCoreHue 2635
                    setvar! breedAspectDistHue 2635
                    setvar! breedAspectPhylHue 2635
                elseif "Fortune" in breedAspectName or "fortune" in breedAspectName
                    setvar! breedAspectCoreHue 2843
                    setvar! breedAspectDistHue 2843
                    setvar! breedAspectPhylHue 2843
                elseif "Frost" in breedAspectName or "frost" in breedAspectName
                    setvar! breedAspectCoreHue 2234
                    setvar! breedAspectDistHue 2234
                    setvar! breedAspectPhylHue 2234
                elseif "Gadget" in breedAspectName or "gadget" in breedAspectName
                    setvar! breedAspectCoreHue 2669
                    setvar! breedAspectDistHue 2669
                    setvar! breedAspectPhylHue 2669
                elseif "Harvest" in breedAspectName or "harvest" in breedAspectName
                    setvar! breedAspectCoreHue 2208
                    setvar! breedAspectDistHue 2086
                    setvar! breedAspectPhylHue 2207
                elseif "Holy" in breedAspectName or "holy" in breedAspectName
                    setvar! breedAspectCoreHue 2153
                    setvar! breedAspectDistHue 2153
                    setvar! breedAspectPhylHue 2153
                elseif "Lightning" in breedAspectName or "lightning" in breedAspectName
                    setvar! breedAspectCoreHue 2650
                    setvar! breedAspectDistHue 2650
                    setvar! breedAspectPhylHue 2650
                elseif "Lyric" in breedAspectName or "lyric" in breedAspectName
                    setvar! breedAspectCoreHue 2241
                    setvar! breedAspectDistHue 2241
                    setvar! breedAspectPhylHue 2241
                elseif "Madness" in breedAspectName or "madness" in breedAspectName
                    setvar! breedAspectCoreHue 1060
                    setvar! breedAspectDistHue 1060
                    setvar! breedAspectPhylHue 1060
                elseif "Poison" in breedAspectName or "poison" in breedAspectName
                    setvar! breedAspectCoreHue 2897
                    setvar! breedAspectDistHue 2897
                    setvar! breedAspectPhylHue 2897
                elseif "Shadow" in breedAspectName or "shadow" in breedAspectName
                    setvar! breedAspectCoreHue 1757
                    setvar! breedAspectDistHue 1790
                    setvar! breedAspectPhylHue 1757
                elseif "Temporal" in breedAspectName or "temporal" in breedAspectName
                    setvar! breedAspectCoreHue 4211
                    setvar! breedAspectDistHue 4211
                    setvar! breedAspectPhylHue 4211
                elseif "Void" in breedAspectName or "void" in breedAspectName
                    setvar! breedAspectCoreHue 2582
                    setvar! breedAspectDistHue 2599
                    setvar! breedAspectPhylHue 2582
                elseif "Water" in breedAspectName or "water" in breedAspectName
                    setvar! breedAspectCoreHue 2592
                    setvar! breedAspectDistHue 1788
                    setvar! breedAspectPhylHue 2592
                elseif "War" in breedAspectName or "war" in breedAspectName
                    setvar! breedAspectCoreHue 2503
                    setvar! breedAspectDistHue 2503
                    setvar! breedAspectPhylHue 2503
                elseif "ReplaceWithAspectName" in breedAspectName
                    break
                else
                    overhead "|* Wrong Aspect Name *|" cRed
                    break
                endif

                if findtype "aspect core" backpack breedAspectCoreHue or findtype "flask" backpack breedAspectDistHue or findtype "phylactery" backpack breedAspectPhylHue or findtype "aspect core" breedSupplyContainer breedAspectCoreHue or findtype "flask" breedSupplyContainer breedAspectDistHue or findtype "phylactery" breedSupplyContainer breedAspectPhylHue
                    break                
                else
                    setvar! breedAspectCoreHue 9999
                endif
            
            endfor
        
        endif
            
        if insysmsg "That feeding trough already has a different aspect pigment in place."
        endif

        while breedAspectCoreHue != 9999 and list breedAspectCountList < breedMaxAspectCharges and not ingump "(x6)" 1942558613

            setvar! breedAspectItemToAdd  0
            setvar! breedAspectItemType   0
            setvar! breedAspectItemHue    0
            setvar! breedAspectItemSource 0
            pushlist breedAspectCountList 1
            
            if insysmsg "That feeding trough already has a different aspect pigment in place."
                overhead "|* Aspect type mismatch *|" cRed
                break
            elseif list breedAspectCountList = breedMaxAspectCharges 
                if findtype "phylactery" backpack breedAspectPhylHue as localAspectItem
                    setvar! breedAspectItemToAdd  localAspectItem
                    setvar! breedAspectItemType   576
                    setvar! breedAspectItemHue    breedAspectPhylHue
                    setvar! breedAspectItemSource backpack
                elseif findtype "phylactery" breedSupplyContainer breedAspectPhylHue as localAspectItem
                    setvar! breedAspectItemToAdd  localAspectItem
                    setvar! breedAspectItemType   576
                    setvar! breedAspectItemHue    breedAspectPhylHue
                    setvar! breedAspectItemSource breedSupplyContainer
                endif
            elseif findtype "flask" backpack breedAspectDistHue as localAspectItem
                setvar! breedAspectItemToAdd  localAspectItem
                setvar! breedAspectItemType   17686
                setvar! breedAspectItemHue    breedAspectDistHue
                setvar! breedAspectItemSource backpack
            elseif findtype "flask" breedSupplyContainer breedAspectDistHue as localAspectItem
                setvar! breedAspectItemToAdd  localAspectItem
                setvar! breedAspectItemType   17686
                setvar! breedAspectItemHue    breedAspectDistHue
                setvar! breedAspectItemSource breedSupplyContainer
            elseif findtype "aspect core" backpack breedAspectCoreHue as localAspectItem
                setvar! breedAspectItemToAdd  localAspectItem
                setvar! breedAspectItemType   3985
                setvar! breedAspectItemHue    breedAspectCoreHue
                setvar! breedAspectItemSource backpack
            elseif findtype "aspect core" breedSupplyContainer breedAspectCoreHue as localAspectItem
                setvar! breedAspectItemToAdd  localAspectItem
                setvar! breedAspectItemType   3985
                setvar! breedAspectItemHue    breedAspectCoreHue
                setvar! breedAspectItemSource breedSupplyContainer
            elseif findtype "phylactery" backpack breedAspectPhylHue as localAspectItem
                setvar! breedAspectItemToAdd  localAspectItem
                setvar! breedAspectItemType   576
                setvar! breedAspectItemHue    breedAspectPhylHue
                setvar! breedAspectItemSource backpack
            elseif findtype "phylactery" breedSupplyContainer breedAspectPhylHue as localAspectItem
                setvar! breedAspectItemToAdd  localAspectItem
                setvar! breedAspectItemType   576
                setvar! breedAspectItemHue    breedAspectPhylHue
                setvar! breedAspectItemSource breedSupplyContainer
            endif

            if breedAspectItemToAdd = 0
                break
            endif

            if insysmsg "You add 1 aspect pigment charge to the trough (max of 6 charges allowed)." or insysmsg "You add 2 aspect pigment charges to the trough (max of 6 charges allowed)."
            endif
            gumpresponse 11 breedGumpID
            if counttype breedAspectItemType breedAspectItemSource breedAspectItemHue as localAspectItemCount
                setvar! breedCurrentAspectItemCount localAspectItemCount
            endif
            wft breedWait
            target breedAspectItemToAdd
            getlabel backpack waitPing
            settimer breedObjectDelayTimer 0
            while counttype breedAspectItemType breedAspectItemSource breedAspectItemHue as localAspectItemCount and breedCurrentAspectItemCount = localAspectItemCount and timer breedObjectDelayTimer < breedWait
            endwhile
            if insysmsg "You add 1 aspect pigment charge to the trough (max of 6 charges allowed)."
                // One point already added to list
            elseif insysmsg "You add 2 aspect pigment charges to the trough (max of 6 charges allowed)."
                pushlist breedAspectCountList 1
            else
                // Timeout - recount pigments
                clearlist breedAspectCountList
                if ingump "(x1)" 1942558613
                    pushlist breedAspectCountList 1
                elseif ingump "(x2)" 1942558613
                    pushlist breedAspectCountList 1
                    pushlist breedAspectCountList 1
                elseif ingump "(x3)" 1942558613
                    pushlist breedAspectCountList 1
                    pushlist breedAspectCountList 1
                    pushlist breedAspectCountList 1
                elseif ingump "(x4)" 1942558613
                    for 4
                        pushlist breedAspectCountList 1
                    endfor
                elseif ingump "(x5)" 1942558613
                    for 5
                        pushlist breedAspectCountList 1
                    endfor
                endif
            endif

        endwhile

        break

    endwhile
    
    removelist breedMountTypeList
    removelist breedAspectCountList

    // Add Fertility Serum
    // - 20499  superior fertility serum     (+20%)
    // - 20500  exceptional fertility serum  (+15%)
    // - 20498  fertility serum              (+10%)
    if insysmsg "This feeding trough already has a similar effect still in place." or insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
    endif

    while breedAutoAddFertilitySerum = 1 and find breedCurrentTrough ground -1 -1 breedUseRange and not insysmsg "This feeding trough already has a similar effect still in place."

        if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
            if breedShowOverheadInfo = 1
                overhead "No line of sight" cRed breedCurrentTrough
                overhead "       ¼        " cRed breedCurrentTrough
            endif
            @ignore breedCurrentTrough
            break
        elseif gumpexists breedGumpID and not ingump "/1,000" 1942558613
            // Skip inactive trough
            @ignore breedCurrentTrough
            break
        elseif not findtype 20499|20500|20498 backpack breedHue and not findtype 20499|20500|20498 breedSupplyContainer breedHue
            break
        elseif not gumpexists breedGumpID
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick breedCurrentTrough
            settimer breedObjectDelayTimer 0
            waitforgump breedGumpID breedWait
        elseif not targetexists
            gumpresponse 6 breedGumpID
            wft breedWait
        elseif findtype 20499|20500|20498 backpack breedHue as localItem
            target localItem
            waitforgump breedGumpID breedWait
        elseif findtype 20499|20500|20498 breedSupplyContainer breedHue as localItem
            target localItem
            waitforgump breedGumpID breedWait
        endif

    endwhile

    // Add Growth Tablets
    // - 29030  growth tablets  (+50)
    if insysmsg "This feeding trough already has a similar effect still in place." or insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
    endif

    while breedAutoAddGrowthTablets = 1 and find breedCurrentTrough ground -1 -1 breedUseRange and not insysmsg "This feeding trough already has a similar effect still in place."

        if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
            if breedShowOverheadInfo = 1
                overhead "No line of sight" cRed breedCurrentTrough
                overhead "       ¼        " cRed breedCurrentTrough
            endif
            @ignore breedCurrentTrough
            break
        elseif gumpexists breedGumpID and not ingump "/1,000" 1942558613
            // Skip inactive trough
            @ignore breedCurrentTrough
            break
        elseif not findtype 29030 backpack breedHue and not findtype 29030 breedSupplyContainer breedHue
            break
        elseif not gumpexists breedGumpID
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick breedCurrentTrough
            settimer breedObjectDelayTimer 0
            waitforgump breedGumpID breedWait
        elseif not targetexists
            gumpresponse 6 breedGumpID
            wft breedWait
        elseif findtype 29030 backpack breedHue as localItem
            target localItem
            waitforgump breedGumpID breedWait
        elseif findtype 29030 breedSupplyContainer breedHue as localItem
            target localItem
            waitforgump breedGumpID breedWait
        endif

    endwhile

    // Add Food
    setvar! breedFoodAdded 0
    if insysmsg "That feeding trough is already full of food." or insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
    endif
    
    while find breedCurrentTrough ground -1 -1 breedUseRange and not insysmsg! "That feeding trough is already full of food."

        if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
            if breedShowOverheadInfo = 1
                overhead "No line of sight" cRed breedCurrentTrough
                overhead "       ¼        " cRed breedCurrentTrough
            endif
            @ignore breedCurrentTrough
            break
        elseif gumpexists breedGumpID and not ingump "/1,000" 1942558613
            // Skip inactive trough
            @ignore breedCurrentTrough
            break
        elseif not findtype 2452|2485|2512|2513|2514|2544|3164|3173|3174|3178|3181|3184|3186|3188|3191|3195|3199|3350|3386|5919|5923|5928|5930 backpack and not findtype 2452|2485|2512|2513|2514|2544|3164|3173|3174|3178|3181|3184|3186|3188|3191|3195|3199|3350|3386|5919|5923|5928|5930 breedSupplyContainer
            overhead "|* Not enough food *|" 33
            break
        elseif not gumpexists breedGumpID
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick breedCurrentTrough
            settimer breedObjectDelayTimer 0
            waitforgump breedGumpID breedWait
        elseif not targetexists
            gumpresponse 2 breedGumpID
            settimer breedObjectDelayTimer 0
            while not targetexists and not insysmsg! "That feeding trough is already full of food." and timer breedObjectDelayTimer < breedWait
            endwhile
        elseif findtype 2452|2485|2512|2513|2514|2544|3164|3173|3174|3178|3181|3184|3186|3188|3191|3195|3199|3350|3386|5919|5923|5928|5930 backpack as localFood
            target localFood
            waitforgump breedGumpID breedWait
            setvar! breedFoodAdded 1
        elseif findtype 2452|2485|2512|2513|2514|2544|3164|3173|3174|3178|3181|3184|3186|3188|3191|3195|3199|3350|3386|5919|5923|5928|5930 breedSupplyContainer as localFood
            target localFood
            waitforgump breedGumpID breedWait
            setvar! breedFoodAdded 1
        endif
        
    endwhile

    // Add Water
    setvar! breedWaterAdded   0
    setvar! breedCanIsChecked 0
    if insysmsg "That feeding trough is already full of water." or insysmsg "You do not see any water sources nearby to fill this container from." or insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
    endif

    while find breedCurrentTrough ground -1 -1 breedUseRange and not insysmsg! "That feeding trough is already full of water."

        if insysmsg "That feeding trough is out of your line of sight." or insysmsg "That is out of your line of sight."
            if breedShowOverheadInfo = 1
                overhead "No line of sight" cRed breedCurrentTrough
                overhead "       ¼        " cRed breedCurrentTrough
            endif
            @ignore breedCurrentTrough
            break    
        elseif gumpexists breedGumpID and not ingump "/1,000" 1942558613
            // Skip inactive trough
            @ignore breedCurrentTrough
            break                            
        elseif insysmsg "You do not see any water sources nearby to fill this container from."
            createlist emptyWatercontainerList
            if findtypelist emptyWatercontainerList "barrel|bucket|empty tub" backpack or findtypelist emptyWatercontainerList "barrel|bucket|empty tub" breedSupplyContainer or findtypelist emptyWatercontainerList "barrel|bucket|empty tub" ground -1 -1 2
                @ignore emptyWatercontainerList
            endif
            removelist emptyWatercontainerList
        elseif findtype "barrel|bucket|empty tub" backpack as localWater
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick localWater
            settimer breedObjectDelayTimer 0
            getlabel backpack waitPing
        elseif findtype "barrel|bucket|empty tub" breedSupplyContainer as localWater
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick localWater
            settimer breedObjectDelayTimer 0
            getlabel backpack waitPing
        elseif findtype "barrel|bucket|empty tub" ground -1 -1 2 as localWater
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick localWater
            settimer breedObjectDelayTimer 0
            getlabel backpack waitPing
        elseif breedCanIsChecked = 0
            if findtype "watering can" backpack or findtype "watering can" breedSupplyContainer
                createlist breedFilledWateringCanList
                setvar! breedWaterTile 1
                if insysmsg "You completely fill the watering can." or insysmsg "You completely fill the water container." or insysmsg "You partialy fill the watering can from what water you can find nearby."
                endif

                // Watering Can Graphic IDs
                //  - a watering can "watering can" 25570
                //  - a painted watering can "watering can" 56416|56417
                // Ground does not work as source for watering cans (only in case the can is not locked down)
                while findtype "watering can" backpack or findtype "watering can" breedSupplyContainer
                    if findtype "watering can" backpack as localWater
                        setvar! breedWateringCan localWater
                    elseif findtype "watering can" breedSupplyContainer as localWater
                        setvar! breedWateringCan localWater
                    endif
                    getlabel breedWateringCan breedWateringCanLabel
                    if ": 0/250" in breedWateringCanLabel 
                        if breedWaterTile = 1
                            while timer breedObjectDelayTimer < breedWaitForObjectDelay
                            endwhile
                            dclick breedWateringCan
                            settimer breedObjectDelayTimer 0
                            getlabel backpack waitPing
                            if insysmsg "You completely fill the watering can." or insysmsg "You completely fill the water container." or insysmsg "You partialy fill the watering can from what water you can find nearby."
                                pushlist breedFilledWateringCanList breedWateringCan
                            else
                                setvar! breedWaterTile 0
                            endif
                        endif
                    else
                        pushlist breedFilledWateringCanList breedWateringCan
                    endif
                    @ignore breedWateringCan
                endwhile
                @unignore breedFilledWateringCanList
                removelist breedFilledWateringCanList
            endif
            setvar! breedCanIsChecked 1
        elseif not findtype "water barrel|water tub|bucket of water|watering can" backpack and not findtype "water barrel|water tub|bucket of water|watering can" breedSupplyContainer and not findtype "water barrel|water tub|bucket of water" ground -1 -1 2
            overhead "|* Need more water *|" 33
            break
        elseif not gumpexists breedGumpID
            while timer breedObjectDelayTimer < breedWaitForObjectDelay
            endwhile
            dclick breedCurrentTrough
            settimer breedObjectDelayTimer 0
            waitforgump breedGumpID breedWait
        elseif not targetexists
            gumpresponse 3 breedGumpID
            settimer breedObjectDelayTimer 0
            while not targetexists and not insysmsg! "That feeding trough is already full of water." and timer breedObjectDelayTimer < breedWait
            endwhile
        elseif targetexists and findtype "water barrel|water tub|bucket of water|watering can" backpack as localWater
            target localWater
            waitforgump breedGumpID breedWait
            setvar! breedWaterAdded   1
            setvar! breedCanIsChecked 0
        elseif targetexists and findtype "water barrel|water tub|bucket of water|watering can" breedSupplyContainer as localWater
            target localWater
            waitforgump breedGumpID breedWait
            setvar! breedWaterAdded   1
            setvar! breedCanIsChecked 0
        elseif targetexists and findtype "water barrel|water tub|bucket of water" ground -1 -1 2 as localWater
            target localWater
            waitforgump breedGumpID breedWait            
            setvar! breedWaterAdded   1
            setvar! breedCanIsChecked 0
        else
            break
        endif

    endwhile
    
    // Check result
    if breedShowOverheadInfo = 1
        @unignore breedCurrentTrough
        if not find breedCurrentTrough ground -1 -1 breedUseRange or not gumpexists breedGumpID
            overhead "Skipped"  cLightOrange breedCurrentTrough
            overhead "   ¼   "  cLightOrange breedCurrentTrough
        elseif not ingump "/1,000" 1942558613
            overhead "Inactive" cLightBlue breedCurrentTrough
            overhead "   ¼   "  cLightBlue breedCurrentTrough
        elseif insysmsg "That feeding trough is already full of food." and insysmsg "That feeding trough is already full of water."
            overhead "Done" cGreen breedCurrentTrough
            overhead " ¼ "  cGreen breedCurrentTrough
        else
            if breedWaterAdded = 0 or breedFoodAdded = 0
                overhead "Resupply Failed"  cRed breedCurrentTrough
                overhead "       ¼       "  cRed breedCurrentTrough
            endif
        endif
    endif
    @ignore breedCurrentTrough

endwhile

@clearignore
gumpclose breedGumpID

overhead "|* Breeding Done *|" cGreen

// Mechanics
// -----------------------
// - Tundra Ostards can not be bred
// - Breeding trough can be accessed and used up to 4 tiles away, but needs line of sight
// - A stronger fertility serum cannot overrite an already existing effect
// - There can be only be one fertility serum and growth tablet active, no possibilty to refresh until the effect is expired
// - Feeding trough graphic id (cannot be rotated): empty 40800 (0 food or 0 water), full 40801 (food and water > 0)
// - Check amount of Aspect Pigment present by searching breeding gump for "(x1)" up to "(x6)". Core & Distlation gives +2, Phylacterys +1. When 5 pigments are already present do not add another core or Distlation or you sacrifice 1 point.
// - When clicking "Add Water", "Add Food", or "Add Aspect Item" you get a target cursor in case more water/food/pigments can be added, and no cursor if already at capacity
// - Adding aspect items is only possible by using the gump button (no drag and drop). Item serials of any remaining aspect items (from stacks) of the added type are going to stay constant.

// System messages:
// ----------------
// - No line of sight (click):              "That is out of your line of sight."
// - No line of sight (gump info):          "That feeding trough is out of your line of sight."
// - More than 4 tiles away:                "That feeding trough is too far away."
// - Max. water:                            "That feeding trough is already full of water."
// - Max. food:                             "That feeding trough is already full of food."
// - Watering Can full:                     "This watering can is already at capacity."
// - Can completely filled (by Bucket):     "You completely fill the watering can."
// - Can partially filled (by Bucket):      "You partialy fill the watering can from what water you can find nearby."
// - Can completely filled (by water tile): "You completely fill the water container."
// - No water tile in useable range:        "You do not see any nearby water containers to fill this from."
// - Max. Aspect Pigment:                   "That feeding trough is already at the maximum amount of aspect pigment allowed."
// - Adding Phylactery:                     "You add 1 aspect pigment charge to the trough (max of 6 charges allowed)."
// - Adding Core or Distlation:             "You add 2 aspect pigment charges to the trough (max of 6 charges allowed)."
// - Wrong aspect type selected:            "That feeding trough already has a different aspect pigment in place."