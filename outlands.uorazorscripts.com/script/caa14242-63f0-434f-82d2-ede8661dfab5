# ReKift/Bank Script
# Created by Skilledthis [OFP] 
# Release date: 27/05/2025
#    
#   
# This is a script to Auto Re-kit/resupply when returning to your Home/Inn 
# After completing a farm run. 

##### UPDATES #####
    # Release: 27/05/2025
        # Initial release. Barebones. 
        # Would restock storage shelf and resupply yourself
        
    # Update 1: 28/05/2025
        # Started the process of creating a system to read chests around you/your inventory
        # Then move the items from your inventory to the correct chest
        # Still a work in progress.
        # Plan to have the depositing system create a list of items in chests/inventory then transfer as needed. 
        
        # Resupplying the storage shelf will automatically select yourself. Prior you had to do it manually. 
        
    # Update 2: 29/05/2025
        # Organizers can be enabled/disabled as you prefer
        # Aspect enabling has been added. So if you're regearing from a death, etc. it will automatically turn on your aspect for you. 
        
    # Update 7: 08/07/2025
        # Adjusted the re-aspecting code due to it breaking on different weapons (Spellbook vs. Weapon)
        # This might need readjusting if more aspects are unlocked. Needs further testing. I just don't have that right now. 
        
    # Update 8: 28/10/2026
        # Fixed some gumps not closing. 
        # Cleaned up the code a little bit.
        # Fixed Aspect being re-applied.
        # Added Skill Mastery Tome

##### Steps prior to using plugin#####      
# Ensure you have already setup:
    
    # Storage Shelf Resupply Profile

    # Any organizers you wish to use, as you can enable them as wanted.

    # Make sure you're within 5 tiles of your storage shelf as well as any chests you want to deposit into
    
    # Ensure [aspect is on the "Aspect Details" page with your chosen aspect selected.
   
######################################################

    overhead "ReGear Script" 89
    overhead "by Skilledthis [OFP]" 89
        
removelist skilledthis_Organizers
createlist skilledthis_Organizers

if not listexists skilledthis_Items
    createlist skilledthis_Items
endif

# ====== Edit these values as needed ====== 
# Which Organizers do you use to deposit items when you are between farm runs? Enable as needed. 
# Change to "1" if you use that organizer or keep as "0" if you don't.
@setvar! skilledthis_OrganizerOne 0
@setvar! skilledthis_OrganizerTwo 0
@setvar! skilledthis_OrganizerThree 0
@setvar! skilledthis_OrganizerFour 0
@setvar! skilledthis_OrganizerFive 0
@setvar! skilledthis_OrganizerSix 0
@setvar! skilledthis_OrganizerSeven 0
@setvar! skilledthis_OrganizerEight 0
@setvar! skilledthis_OrganizerNine 0
@setvar! skilledthis_OrganizerTen 0
@setvar! skilledthis_OrganizerEleven 0
@setvar! skilledthis_OrganizerTwelve 0
@setvar! skilledthis_OrganizerThirteen 0
@setvar! skilledthis_OrganizerFourteen 0
@setvar! skilledthis_OrganizerFifteen 0
@setvar! skilledthis_OrganizerSixteen 0
@setvar! skilledthis_OrganizerSeventeen 0
@setvar! skilledthis_OrganizerEighteen 0
@setvar! skilledthis_OrganizerNineteen 0
@setvar! skilledthis_OrganizerTwenty 0

# Set this to 1 if you want to ID/Recycle items // Change to 0 if you want to disable it
@setvar! skilledthis_Recycler 1

# Set this to 1 if you want to deposit gold/bank checks into a deposit safe // Change to 0 if you want to disable it
@setvar! skilledthis_BankDeposit 1

# Set this to 1 if you want to use a repair bench to repair your items // Change to 0 if you want to disable it
@setvar! skilledthis_RepairBench 1

# Set this to 1 if you own a resource stockpile // Change to 0 if you want to disable it
@setvar! skilledthis_ResourceStockpile 1

# Set this to 1 if you own a Skill Mastery Tome // Change to 0 if you want to disable it
@setvar! skilledthis_skilltome 1


# ====== Do not edit anything below here ======    
# I personally prefer resupplying/restocking prior to depositing items due to keeping bags in correct order/organizer    

if skilledthis_OrganizerOne == 1
    pushlist skilledthis_Organizers '1'
endif
if skilledthis_OrganizerTwo == 1
    pushlist skilledthis_Organizers '2'
endif
if skilledthis_OrganizerThree == 1
    pushlist skilledthis_Organizers '3'
endif
if skilledthis_OrganizerFour == 1
    pushlist skilledthis_Organizers '4'
endif
if skilledthis_OrganizerFive == 1
    pushlist skilledthis_Organizers '5'
endif
if skilledthis_OrganizerSix == 1
    pushlist skilledthis_Organizers '6'
endif
if skilledthis_OrganizerSeven == 1
    pushlist skilledthis_Organizers '7'
endif
if skilledthis_OrganizerEight == 1
    pushlist skilledthis_Organizers '8'
endif
if skilledthis_OrganizerNine == 1
    pushlist skilledthis_Organizers '9'
endif
if skilledthis_OrganizerTen == 1
    pushlist skilledthis_Organizers '10'
endif
if skilledthis_OrganizerEleven == 1
    pushlist skilledthis_Organizers '11'
endif
if skilledthis_OrganizerTwelve == 1
    pushlist skilledthis_Organizers '12'
endif
if skilledthis_OrganizerThirteen == 1
    pushlist skilledthis_Organizers '13'
endif
if skilledthis_OrganizerFourteen == 1
    pushlist skilledthis_Organizers '14'
endif
if skilledthis_OrganizerFifteen == 1
    pushlist skilledthis_Organizers '15'
endif
if skilledthis_OrganizerSixteen == 1
    pushlist skilledthis_Organizers '16'
endif
if skilledthis_OrganizerSeventeen == 1
    pushlist skilledthis_Organizers '17'
endif
if skilledthis_OrganizerEighteen == 1
    pushlist skilledthis_Organizers '18'
endif
if skilledthis_OrganizerNineteen == 1
    pushlist skilledthis_Organizers '19'
endif
if skilledthis_OrganizerTwenty == 1
    pushlist skilledthis_Organizers '20'
endif


# Restock the storage shelf then resupply your loadout from the storage shelf
if findtype "storage shelf" ground any any 5 as our_shelf
        menu our_shelf 0 
        wft
        target self
        overhead "RESTOCK"
        menu our_shelf 1
        overhead "RESUPPLY"
        waitforgump 3232825965
        gumpclose
endif

# Add all of your unidentified items into a recycler, identify them, then recycle them. 
# Make sure your recycle options are setup otherwise you'll recycle everything

if skilledthis_Recycler == 1
    if findtype "ornate elven chest" ground any any 5 as our_recycler
    overhead "RECYCLE"
    gumpclose
    menu our_recycler 1
    wait 1000
    dclick our_recycler
    # wait 1000
    waitforgump 4045111101
    gumpresponse 7
    waitforgump 4045111101
    gumpresponse 6
    waitforgump 4045111101
    gumpresponse 6
    waitforgump 4045111101
    gumpresponse 5
    waitforgump 4045111101
    target self         
    gumpclose
    endif
endif

if skilledthis_BankDeposit == 1
    overhead "BANKING"
    if findtype "bank deposit safe" ground any any 5 as our_bank
        menu our_bank 0
    endif
endif

if skilledthis_ResourceStockpile == 1
    if findtype "resource container" ground any any 5 as our_stockpile
        overhead "DEPOSITING RESOURCES"
        menu our_stockpile 0
        wft
        target self
    else 
        overhead "NO STOCKPILE FOUND"
    endif
endif

if skilledthis_skilltome == 1
    if findtype "skill mastery tome" ground any any 5 as our_skilltome
        overhead "DEPOSITING SKILL SCROLLS"
        menu our_skilltome 0
    else 
        overhead "NO SKILL TOME FOUND"
    endif
endif

# Raw aspect enabling, but it works for now.
gumpclose 
say "[aspect"
waitforgump 2424293173
    gumpresponse 8
    waitforgump 2424293173
    gumpresponse 8
    waitforgump 2424293173
    gumpresponse 13
    waitforgump 2424293173
    gumpresponse 13
    waitforgump 2424293173
    gumpresponse 17
    waitforgump 2424293173
    gumpresponse 17
    waitforgump 2424293173
    gumpclose

gumpclose


#MagicVaultWillBeAddedHere
#AllTomesForDepositingShitWillBeAddedHere


#Repair after adding tomes/magic vault to avoid depositing equipped magic items
if skilledthis_RepairBench == 1
    if findtype "repair bench" ground any any 5 as our_repair
        overhead "REPAIRING"
        dclick our_repair
    else 
        overhead "NO REPAIR BENCH FOUND"
    endif
endif

# Searches for nearby chests, compares the items in the chest with items in your inventory
# Takes items from your inventory and adds them to the proper chest
#
# V1 of item storage for skilledthis/banking
if findtype 3712 ground any any 5 as chests    
    # Currently does it by item name 
    # This will be adjusted to being a list later
    while findtype "rune" chests as item and findtype "rune" self as item
        hotkey "Set Grab Item HotBag" 
        wait 400
        target chests
        hotkey "Grab Item"
        wait 400
        target item
    endwhile
    while findtype 22336 chests as item and findtype 22336 self as item
        hotkey "Set Grab Item HotBag" 
        wait 400
        target chests
        hotkey "Grab Item"
        wait 400
        target item
    endwhile
    overhead "No items to transfer"
endif

# Loop through the Organizer list to run the Organizers that have been enabled above
foreach 'item' in 'skilledthis_Organizers'
    organizer 'item'
endfor
 
    overhead "[REKIT COMPLETE]" 