# ID Your Recycler + Put into Vault by JaseOwns
# UO Outlands
@setvar! pausePuttingAwayUntilArmsLoreIsDone 1

if targetexists 
    hotkey "Cancel Current Target"
endif

# Opened the Magic Item Recycler
@setvar! myDynamicFind 0
if findtype "ornate elven chest|magic item recycler" ground -1 -1 2 as myDyanmicFindValue
    @setvar! myDynamicFind myDyanmicFindValue   
elseif findtype "ornate elven chest|magic item recycler" convenienceChest -1 -1 2 as myDyanmicFindValue
    @setvar! myDynamicFind myDyanmicFindValue   
endif
if myDynamicFind != 0
    dclick myDynamicFind
    wait 200
    waitforgump 4045111101 500
    gumpresponse 7 4045111101
    waitforgump 4045111101 500
    gumpresponse 6 4045111101
    waitforgump 4045111101 500
    gumpresponse 6 4045111101
    waitforgump 4045111101 500
    gumpclose 4045111101
    if pausePuttingAwayUntilArmsLoreIsDone = 1
        while not targetexists 
            useskill "armslore"
            wft 500
        endwhile
        while targetexists 
        endwhile
    endif

    @setvar! myDynamicFindVault 0
    if findtype "magic item chest|sm magic item vault" ground -1 -1 2 as myDyanmicFindVaultValue
        @setvar! myDynamicFindVault myDyanmicFindVaultValue   
    elseif findtype "magic item chest|sm magic item vault" convenienceChest -1 -1 2 as myDyanmicFindVaultValue
        @setvar! myDynamicFindVault myDyanmicFindVaultValue   
    endif
    # Opened the Magic Item Vault
    if myDynamicFindVault != 0
        dclick myDynamicFindVault
        waitforgump 938517546 500
        while not targetexists 
            gumpresponse 2 938517546
            waitfortarget 500
            waitforgump 938517546 500
        endwhile
        if targetexists 
            # Target Item Recycler
            target myDynamicFind
        endif
    endif
endif

wait 200
gumpclose 938517546
