                    elseif FrostAspectTier = 6
                        cooldown "Frost Shell Cooldown" 24000
                    elseif FrostAspectTier = 7
                        cooldown "Frost Shell Cooldown" 23000
                    elseif FrostAspectTier = 8
                        cooldown "Frost Shell Cooldown" 22000
