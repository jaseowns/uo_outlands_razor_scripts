            if EnableUsePotionKegs = 1 and findtype 'empty bottle%s%' self and findtype 'keg' self and timer 'PotionKegPVPCooldown' > 30000
                @setvar! PotionStockCheck 0

                while PotionStockCheck < 8 and findtype 'empty bottle%s%' self
                    if PotionStockCheck = 0 
                        if HealingPotionAmount = 0
                            @setvar! PotionStockCheck 1
                        else 
                            @setvar! PotionType 3852
                            @setvar! KegColour 253
                            @setvar! PotionAmounttoFill HealingPotionAmount
                            @setvar! PotionStockCheck 1
                        endif
                    elseif PotionStockCheck = 1
                        if CurePotionAmount = 0
                             @setvar! PotionStockCheck 2
                        else 
                            @setvar! PotionType 3847
                            @setvar! KegColour 44
                            @setvar! PotionAmounttoFill CurePotionAmount
                            @setvar! PotionStockCheck 2
                        endif
                    elseif PotionStockCheck = 2
                        if RefreshPotionAmount = 0
                            @setvar! PotionStockCheck 3
                        else 
                            @setvar! PotionType 3851
                            @setvar! KegColour 37
                            @setvar! PotionAmounttoFill RefreshPotionAmount
                            @setvar! PotionStockCheck 3
                        endif
                    elseif PotionStockCheck = 3  
                        if StrengthPotionAmount = 0
                            @setvar! PotionStockCheck 4
                        else 
                            @setvar! PotionType 3849
                            @setvar! KegColour 956
                            @setvar! PotionAmounttoFill StrengthPotionAmount
                            @setvar! PotionStockCheck 4
                        endif
                    elseif PotionStockCheck = 4
                        if AgilityPotionAmount = 0
                            @setvar! PotionStockCheck 5
                        else 
                            @setvar! PotionType 3848
                            @setvar! KegColour 93
                            @setvar! PotionAmounttoFill AgilityPotionAmount
                            @setvar! PotionStockCheck 5
                        endif
                    elseif PotionStockCheck = 5 
                        if ResistPotionAmount = 0
                            @setvar! PotionStockCheck 6
                        else 
                            @setvar! PotionType 3846
                            @setvar! KegColour 1109
                            @setvar! PotionAmounttoFill ResistPotionAmount
                            @setvar! PotionStockCheck 6
                        endif
                    elseif PotionStockCheck = 6 
                        if PoisonPotionAmount = 0
                            @setvar! PotionStockCheck 7
                        else 
                            @setvar! PotionType 3850
                            @setvar! KegColour 363
                            @setvar! PotionAmounttoFill PoisonPotionAmount
                            @setvar! PotionStockCheck 7
                        endif
                    elseif PotionStockCheck = 7 
                        if ExplosionPotionAmount = 0
                            @setvar! PotionStockCheck 8
                        else 
                            @setvar! PotionType 3853
                            @setvar! KegColour 419
                            @setvar! PotionAmounttoFill ExplosionPotionAmount
                            @setvar! PotionStockCheck 8
                        endif
                    else
                        break
                    endif

                    while counttype PotionType self < PotionAmounttoFill
                        if not findtype 'empty bottle%s%' self
                            if EnableOverheadMessages = 1 and timer 'PotionKegTimer' > 5000
                                overhead '[ NO EMPTY BOTTLES... ]' 337
                                settimer 'PotionKegTimer' 0
                            endif
                            break
                        endif

                        if diffhits > HealPotionHPdiff
                            break
                        endif

                        if findtype 'keg' self KegColour as myKeg
                            dclick myKeg
                            wait 250
                            if EnableOverheadMessages = 1
                                if timer 'PotionKegTimer' > 2000
                                    overhead '[ FILLING POTS... ]' KegColour
                                    settimer 'PotionKegTimer' 0
                                endif
                            endif
                        else
                            if EnableOverheadMessages = 1 and timer 'PotionKegTimer' > 5000
                                overhead '[ NO KEG TO USE... ]' KegColour
                                settimer 'PotionKegTimer' 0
                            endif
                            break
                        endif
                        if insysmsg "You have been in combat with another player"
                            settimer "PotionKegPVPCooldown" 0
                            break
                        endif
                    endwhile

                    if counttype PotionType self < PotionAmounttoFill and not findtype 'empty bottle%s%' self
                        if EnableOverheadMessages = 1 and timer 'PotionKegTimer' > 5000
                            overhead '[ NO EMPTY BOTTLES... ]' 337
                            settimer 'PotionKegTimer' 0
                        endif
                        break
                    endif
                endwhile
            endif 
                
            if EnableAutoExplosionPots = 1 and diffhits < CastGreaterHealHPdiff
                if findtype 'purple potion' self as explotPot
                    getlabel explotPot potLabel
                    if "(" in potLabel
                        if timer PurplePotionTimer > PurplePotionCooldown
                            @setvar! PurplePotionReady 1
                        else
                            @setvar! PurplePotionReady 0
                        endif
                    else
                        @setvar! PurplePotionReady 1
                    endif

                    if skill 'Alchemy' < 80
                        if timer TelekinesisTimer > 60000 or ClosestTargetisSticky = 0
                            if PurplePotionReady = 1 and find ClosestTarget ground -1 -1 TargetAttackRange and not dead ClosestTarget
                                if findtype 'purple potion' self
                                    settimer AntiStallTimer 0
                                    while not targetexists and timer AntiStallTimer < 1500
                                        if timer AntiStallTimer > 1500
                                            break
                                        endif
                                        cast 'Telekinesis'
                                        wait 500
                                    endwhile
                                    clearsysmsg
                                    wft 500
                                    target ClosestTarget
                                    wait 250
                                    if insysmsg "You are too far"
                                        @setvar! ClosestTargetisSticky 0
                                        clearsysmsg
                                    else
                                        if EnableOverheadMessages = 1 and timer PurplePotionMessageTimer > 4500
                                            overhead  '[ EXPLOSION POTION! ]' 419
                                            settimer PurplePotionMessageTimer 0
                                        endif
                                        settimer TelekinesisTimer 0
                                        @setvar! ClosestTargetisSticky 1
                                    endif
                                endif
                            endif
                        endif
                    else
                        @setvar! ClosestTargetisSticky 1
                    endif
                else
                    if EnableOverheadMessages = 1 and timer PurplePotionMessageTimer > 15000
                        overhead '[ NO PURPLE POTIONS ]' 337
                        settimer PurplePotionMessageTimer 0
                    endif
                endif
            endif

            @setvar! CastingWasInterrupted 0

            if targetexists
                hotkey 'cancel current target'
            endif

            if dead ClosestTarget or not find ClosestTarget ground -1 -1 TargetAttackRange
                @setvar! RepeatCastingPoison 0
                @setvar! AttackModeActive 0
                @setvar! ClosestTargetisSticky 0
                @setvar! TargetSwap 0
                settimer TargetChecker 0         
                break
            endif

            if EnableAutoExplosionPots = 1
                if timer TelekinesisTimer > 60000
                    @setvar! ClosestTargetisSticky 0
                    settimer TelekinesisTimer 0                    
                endif
            endif

            if PurplePotionReady = 1 and ClosestTargetisSticky = 1 and not dead ClosestTarget and find ClosestTarget ground -1 -1 TargetAttackRange and diffhits < CastGreaterHealHPdiff
                settimer AntiStallTimer 0
                while not insysmsg "Where should i throw this potion?" and timer AntiStallTimer < 1500
                    potion 'explosion'
                    if timer AntiStallTimer > 1500
                        settimer AntiStallTimer 0
                        break
                    endif
                endwhile

                @setvar! PurplePotionReady 0
                settimer PurplePotionTimer 0
                settimer AntiStallTimer 0

                while not targetexists and timer AntiStallTimer < 1500
                    if dead ClosestTarget or not find ClosestTarget ground -1 -1 TargetAttackRange
                        @setvar! RepeatCastingPoison 0
                        @setvar! AttackModeActive 0
                        @setvar! ClosestTargetisSticky 0
                        @setvar! CastingWasInterrupted 1
                        @setvar! TargetSwap 0
                        hotkey 'cancel current target'
                        break
                    endif

                    if timer AntiStallTimer > 1500
                        settimer AntiStallTimer 0
                        break
                    endif
                endwhile

                if dead ClosestTarget or not find ClosestTarget ground -1 -1 TargetAttackRange
                    break
                endif 

                if CastingWasInterrupted = 0
                    target ClosestTarget
                    cooldown "Purple Potion" PurplePotionCooldown
                    getlabel backpack packdesc
                    wait 250
                endif
            endif
        
            if counttype 29012 self = 0 and EnableMagicMushroomMaker = 1
                while counttype 29012 self < MakeMushroomAmount and mana > 3 and diffhits < CastGreaterHealHPdiff
                    if timer 'MushroomMakerTimer' > 4500
                        overhead '[ MAKING SHROOMS... ]' 419
                        settimer 'MushroomMakerTimer' 0
                    endif

                    if not casting
                        cast 'create food'
                        wait 500
                    endif

                    if diffhits > CastGreaterHealHPdiff
                        break
                    endif
                endwhile

                if dead
                    break
                endif
            endif

            if EnableGoldVacuum = 1 and DisableVacuums != 1
                if findtype "gold coin" ground -1 -1 15 as droppedmoney and timer "GoldRadar" > 3500
                    overhead " ¼ " 149 droppedmoney
                    settimer "GoldRadar" 0
                endif
                
                while findtype "gold coin" ground -1 -1 2 as droppedmoney and diffhits < CastGreaterHealHPdiff
                    overhead " ² " 149
                    hotkey "Grab Item"
                    wft 2500
                    target droppedmoney
                    wait 250

                    if dead
                        break
                    endif

                    if diffhits >= CastGreaterHealHPdiff
                        @setvar! AttackModeActive 1
                        break
                    endif

                    if insysmsg "Invalid or inaccessible item"
                        wait 500
                        @ignore droppedmoney
                    endif
                    wait 250
                endwhile
            endif

            if EnableDungeonCleanup = 1 and diffhits < CastGreaterHealHPdiff
                while findtype "iron ingot%s|board%s|cut up leather|3972|3962|3963|3980|3976|3973|3974|3981" ground -1 -1 2 as item
                    if EnableOverheadMessages = 1
                        if timer "DungeonCleanup" > 1500
                            overhead '[ CLEANUP... ]' 420
                            settimer "DungeonCleanup" 0
                        endif
                    else
                        if timer "DungeonCleanup" > 1500
                            overhead ' ² ' 420
                            settimer "DungeonCleanup" 0
                        endif
                    endif
                    hotkey "Grab Item"
                    wft 1000
                    target item
                    wait 500
                    if dead
                        break
                    endif
                    if diffhits > CastGreaterHealHPdiff
                        break
                    endif
                endwhile

                if findtype "iron ingot%s|board%s|cut up leather|3972|3962|3963|3980|3976|3973|3974|3981" ground -1 -1 15 as dungeonjunk and timer "DungeonCleanupRadar" > 3500
                    overhead "¼" 420 dungeonjunk
                    settimer "DungeonCleanupRadar" 0
                endif
            endif

            if EnableAutoCarving = 1 and findtype 11552 self
                while findtype "corpse" ground -1 -1 2 as deadbody and diffhits < CastGreaterHealHPdiff 
                   settimer SkinningTimeoutTimer 0
