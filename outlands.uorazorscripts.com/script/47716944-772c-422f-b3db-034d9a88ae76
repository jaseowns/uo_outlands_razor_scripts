                                                        elseif insysmsg "Perhaps" or insysmsg "They do not appear to have anything to offer you"
                                                            sysmsg 'Nearby MOB detected - Loot storage loop cancelled!' 153
                                                            @setvar! FoundNewTarget 1
                                                            break 
                                                        endif
                                                    endif
                                                else 
