# Trough search range in tiles (1 - 18)
setvar! breedScanRange 18

# Interaction range in tiles to service troughs (1 - 4)
setvar! breedUseRange 4

# Serial of external restock container on the ground (set to 0 to disable, sub-containers are not supported)
# To get the serial: type >info in-game, target your container, and copy the serial (0x...)
setvar! breedSupplyContainer 0

# Action on inactive troughs (empty, missing creature, ready, or finished)
# 0 = Skip inactive troughs
# 1 = Open gump and wait for input
setvar! breedShowInactiveTrough 1

# Automatically add fertility serum (0 = No, 1 = Yes)
setvar! breedAutoAddFertilitySerum 1

# Automatically add growth tablets (0 = No, 1 = Yes)
setvar! breedAutoAddGrowthTablets 0

# Trough overhead info display (0 = Hide trough overhead, 1 = Show trough overheads)
setvar! breedShowOverheadInfo 1

# Amount of aspect charges to add (0 - 6, 0 = Disabled)
# - Cores & Distillations = 2 charges, Phylacteries = 1 charge
# - Priority: Distillation -> Core -> Phylactery
# - Prevents point waste (e.g., at 5/6 charges, only Phylacteries are used)
# - Requires configuring the 'Aspect assignment' lists below
setvar! breedMaxAspectCharges 0

# Aspect assignment for horses: allow mixed body types in the same trough (e.g., 200 paired with 204)
# 0 = Strict  (matching body types only)
# 1 = Allowed (mixed body types)
setvar! breedAllowMixedHorseBodies 0

# =====================================================================
# 'ASPECT ASSIGNMENTS' (Required only if breedMaxAspectCharges > 0)
# Add desired aspect names below. Quotes are optional.
#
# 'Supported Aspects:'
# Agorawave   Air    Arcane     Artisan  Blood    Command  Death
# Discipline  Earth  Eldritch   Fire     Fortune  Frost    Gadget
