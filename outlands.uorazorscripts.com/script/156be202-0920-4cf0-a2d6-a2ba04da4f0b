            @setvar! Stealthing 0
            @setvar! StealthingReady 0
            @setvar! KeepOnTrucking 0
            hotkey 'Toggle War Only'
            break
        endif

        if EnableOverheadWarnings = 1
            if cooldown 'Stealth'
                if insysmsg 'You have 0 stealth steps remaining.' and hidden
                    settimer DoNotMoveTimeout 0
                    clearsysmsg 
                    while not insysmsg 'You feel ready to continue stealthing.'
                        if timer DoNotMoveTimer > 500
                            if EnableOverheadMessages = 1
                                overhead '[ !!! STOP !!! ]' 37
                            else
                                overhead ' Ï ' 37
                            endif
                            settimer NoTargetTimer 0
                            settimer DoNotMoveTimer 0
                        endif
                        
                        if not hidden
                            if EnableOverheadMessages = 1
                                overhead '[ STEALTH ENDED! ]' 2117
                            else
                                overhead ' Ï ' 2117
                            endif
