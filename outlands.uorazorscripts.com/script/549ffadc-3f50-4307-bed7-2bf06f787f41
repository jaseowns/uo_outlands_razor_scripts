while not dead

    while not insysmsg 'You have acquired enough experience to upgrade your Artisan Mastery Level'
        wait 500
    endwhile

    overhead 'ARTISAN ASPECT XP CAPPED!' 53

    say '[aspect'
    waitforgump 2424293173 2000

    if ingump 'Upgrade tier' 2424293173

        overhead 'UPGRADING ARTISAN ASPECT!' 53

        gumpresponse 7 2424293173
        waitforgump 2424293173 2000

        wait 200
        
        gumpresponse 7 2424293173
        waitforgump 2424293173 2000
        
        wait 200

        overhead 'ARTISAN ASPECT UPGRADED!' 63

    endif

    if gumpexists 2424293173
        gumpclose 2424293173
    endif

    clearsysmsg

    wait 5000

endwhile