                                    if findtype "Yellow Potion" self as HealPot
                                        getlabel HealPot HealPotlabel
                                        if "next" in HealPotlabel
                                            // Do nothing
                                        else
                                            @setvar! HealPotionCheck 0

                                            if counttype 3852 self as HealPotCount
                                                @setvar! HealPotionCheck HealPotCount
                                            endif

                                            clearsysmsg
                                            dclicktype 3852
                                            getlabel backpack backpackdesc
                                            wait 250

                                            if HealPotionCheck != counttype 3852 self or insysmsg "potion satchel used"
                                                settimer 'HealPotionTimer' 0
                                                cooldown "Healing Potion" HealPotionCooldown
                                                if EnableOverheadMessages = 1
                                                    if insysmsg "potion satchel used"
                                                        overhead '[ FREE HEAL POTION ]' 253
                                                    else
                                                        overhead "[ HEAL POTION ]" 253
                                                    endif
                                                endif
                                                clearsysmsg
                                            endif
                                        endif
                                    else
                                        if timer 'HealingPotionMessageTimer' > 4500
                                            overhead "[ NO HEAL POTS! ]" 337
                                            settimer 'HealingPotionMessageTimer' 0
                                        endif
                                    endif
                                endif
                            endif

                            if EnablePanaceaPotion = 1 
                                if skill 'Alchemy' >= 80
                                    if findbuff "bleed" or findbuff "diseased"
                                        if not findbuff "panacea potion cooldown"
                                            if findtype "Orange Potion" self
                                                dclicktype "Orange Potion"
                                                wait 500
                                                if findbuff "panacea potion cooldown" and EnableOverheadMessages = 1
                                                    overhead "[ PANACEA POTION ]" 2117
                                                endif
                                                cooldown 'Panacea Potion' 30000
                                            else 
                                                if timer 'CurePotionMessageTimer' > 15000
                                                    overhead "[ NO CURE POTS! ]" 337
                                                    settimer 'CurePotionMessageTimer' 0
                                                endif
                                            endif
                                        else 
                                            if EnableOverheadMessages = 1 and timer PanaceaOverheadTimer > 15000
                                                overhead '[ PANACEA ON COOLDOWN! ]' 37
                                                settimer PanaceaOverheadTimer 0
                                            endif
                                        endif
                                    endif
                                endif
                            endif

                            if EnableCleansingBrews = 1
                                if findbuff "Disease" or findbuff "Bleed"
                                    if timer CleansingBrewTimer > 120000
                                        if findtype 50675 self 2935 as CleansingBrew
                                            dclick CleansingBrew
                                            if EnableOverheadMessages = 1
                                                overhead '[ CLEANSING BREW ]' 2117
                                            endif
                                            cooldown 'Cleansing Brew' 120000
                                            settimer CleansingBrewTimer 0
                                            wait 250
                                        else
                                            if timer CleansingBrewOverhead > 15000
                                                overhead "[ NO CLEANSING BREWS! ]" 337
                                                settimer CleansingBrewOverhead 0
                                                settimer CleansingBrewTimer 0
                                            endif
                                        endif
                                    else 
                                        if EnableOverheadMessages = 1 and timer CleansingBrewOverhead > 15000
                                            overhead '[ BREW ON COOLDOWN! ]' 37
                                            settimer CleansingBrewOverhead 0
                                        endif
                                    endif
                                endif
                            endif

                            if EnableCurePotion = 1
                                while poisoned
                                    if findtype "Orange Potion" self
                                        dclicktype "Orange Potion"
                                        if EnableOverheadMessages = 1 and timer 'CurePotionMessageTimer' > 3500
                                            overhead "[ CURE POTION ]" 44
                                            settimer 'CurePotionMessageTimer' 0
                                        endif
                                        wait 250
                                    else
                                        if timer 'CurePotionMessageTimer' > 5000
                                            overhead "[ NO CURE POTS! ]" 337
                                            settimer 'CurePotionMessageTimer' 0
                                        endif
                                        break
                                    endif
                                    if diffhits > 40
                                        break
                                    endif
                                endwhile
                            endif
                            
                            if skill 'Healing' > 0
                                if diffhits > 0 and not bandaging and not hidden
                                    if findtype 'clean bandage%s%' self
                                        if targetexists
                                            hotkey 'cancel current target'
                                        endif
                                        hotkey 'Bandage Self'
                                        if EnableOverheadMessages = 1
                                            if timer BandageMessageTimer > 5000
                                                overhead "[ BANDAGING... ]" 88
                                                settimer BandageMessageTimer 0
                                            endif
                                        endif
                                        wait 500
                                    else
                                        if timer BandageMessageTimer > 5000 and EnableOverheadMessages = 1
                                            overhead "[ OUT OF BANDAGES! ]" 337
                                            settimer BandageMessageTimer 0
                                        endif
                                    endif
                                endif
                            endif

                            if EnableRefreshPotion = 1 
                                if diffstam >= RefreshPotionSPdiff and not hidden
                                    if findtype "Red Potion" self
                                        dclicktype "Red Potion"
                                        if EnableOverheadMessages = 1
                                            overhead "[ REFRESH POTION ]" 37
                                        endif
                                        wait 500
                                    else
                                        if timer RefreshPotionMessageTimer > 4500
                                            overhead "[ NO REFRESH POTS! ]" 337
                                            settimer RefreshPotionMessageTimer 0
                                        endif
                                    endif
                                    wait 500
                                endif
                            endif
                        endwhile
                        
                        wait 500

                        if hidden
                            hotkey 'Toggle Peace Only'
                            break
                        elseif not hidden
                            if EnableSmokeBombWhenAggro = 1
                                if counttype 52149 self > 0
                                    if not cooldown 'Smoke Bomb' and not hidden
                                        clearsysmsg
                                        hotkey 'Smoke Bomb'
                                        wait 500
                                        if insysmsg 'You must wait another'
                                            if EnableOverheadMessages = 1
                                                overhead '[ SMOKE BOMB UNAVAILABLE ]' 333
                                            endif
                                            hotkey 'Toggle War Only'
                                            break
                                        else
                                            if hidden
                                                if EnableOverheadMessages = 1
                                                    overhead '[ SMOKE BOMB! ]' 1790
                                                endif
                                                clearsysmsg 
                                                @setvar! Stealthing 1
                                                @setvar! StealthingReady 1
                                                cooldown 'Hiding' 0
                                                cooldown 'Stealth' 10000
                                                cooldown 'Smoke Bomb' SmokeBombCooldown
                                            endif
                                            break
                                        endif
                                    else
                                        if EnableOverheadMessages = 1
                                            overhead '[ SMOKE ON COOLDOWN! ]' 33
                                        endif
                                        hotkey 'Toggle War Only'
                                        break
                                    endif
                                else
                                    if EnableOverheadMessages = 1
                                        overhead '[ NO SMOKE BOMBS ]' 337
                                    endif
                                    cooldown 'Hiding' 1000
                                    if not hidden
                                        hotkey 'Toggle War Only'
                                    break
                                    endif
                                endif
                            else 
                                hotkey 'Toggle War Only'
                                @setvar! Stealthing 0
                                @setvar! StealthingReady 0
                                @setvar! KeepOnTrucking 0
                                clearsysmsg 
                            endif
                            break
                        endif
                        if dead CurrentTarget
                            wait 1500
                            settimer STORELOOT 0
                            break
                        endif
                    endif
                endif
                if dead 
                    break
                endif
            endwhile
        endif

        if EnableOverheadMessages = 1
            if insysmsg "something invisible out of"
                overhead "¼ SOMEONE HIDING! ¼" 6
            endif

            if insysmsg "additional mastery chain link"
                overhead "[ CHAIN LINK UNLOCKED!! ]" 149
                wait 500
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[Yes"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif
            
            if insysmsg "enough experience to upgrade"
                overhead "[ ASPECT TIER UNLOCKED!! ]" 2234
                wait 500
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[Whistle"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif
            
            if insysmsg "You have unlocked a codex upgrade point"
                overhead "[ CODEX POINT UNLOCKED! ]" 2114
                wait 250
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[HighFive"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif
            
            if insysmsg "You have completed a society job"
                overhead "[ SOCIETY JOB COMPLETE! ]" 419
                wait 500
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[Awoo"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif

            if insysmsg "Society Job Progress"
                overhead "[ ² SOCIETY POINTS ² ]" 419
            endif
            
            if insysmsg "causes you to bleed"
                overhead "[ YOU ARE BLEEDING... ]" 2118
            endif

            if insysmsg "been struck by an ancient blight"
                overhead "[ DISEASED... ]" 1109
            endif

            if insysmsg "You feel chilled!"
                overhead "[ YOU ARE CHILLED... ]" 2234
            endif

            if insysmsg "You resist a disease effect"
                overhead "[ DISEASE RESISTED! ]" 888
            endif

            if insysmsg "resist a bleed"
                overhead "[ BLEED RESISTED! ]" 888
            endif

            if insysmsg "The creature pierces and bypasses your armor!"
                overhead "[ YOU ARE PIERCED... ]" 337
            endif

            if insysmsg "Their attack disarms you!"
                overhead "[ DISARMED! ]" 337 
            endif

            if insysmsg "Their attack hamstrings you!"
                overhead "[ HAMSTRUNG! ]" 337
            endif
 
            if insysmsg "attempting to steal" or insysmsg "attempting to peek"
                overhead "[ THIEF DETECTED! ]" 910
            endif
        else
            if insysmsg "something invisible out of"
                overhead "¼ SOMEONE HIDING! ¼" 6
            endif

            if insysmsg "additional mastery chain link"
                overhead "[ ² CHAIN! ² ]" 149
                wait 500
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[Yes"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif
            
            if insysmsg "enough experience to upgrade"
                overhead "[ ² ASPECT ² ]" 2234
                wait 500
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[Whistle"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif
            
            if insysmsg "You have unlocked a codex upgrade point"
                overhead '[ ² CODEX! ² ]' 2114
                wait 250
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[HighFive"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif

            if insysmsg "You have completed a society job"
                overhead "[ SOCIETY COMPLETE! ]" 419
                wait 500
                if EnableUseEmotes = 1 and timer EmoteCooldownTimer > SetEmoteCooldown
                    wait 500
                    say "[Awoo"
                    settimer EmoteCooldownTimer 0
                    cooldown "Emote Cooldown" SetEmoteCooldown
                endif
            endif
            
            if insysmsg "Society Job Progress"
                overhead "[ ² SOCIETY ² ]" 419
            endif

            if insysmsg "attempting to steal" or insysmsg "attempting to peek"
                overhead "[ THIEF DETECTED! ]" 910
            endif

            if insysmsg "Their attack disarms you!"
                overhead "*disarmed*" 337 
            endif
            
            if insysmsg "Their attack hamstrings you!"
                overhead "*hamstrung*" 337
            endif
        endif

        if dead 
            break
        endif
    endwhile

    //////////////////////////////
    //  END ATTACK TARGET LOOP  //
    //////////////////////////////

    if dead 
        break
    endif
endwhile

//////////////////////
//  END ALIVE LOOP  //
//////////////////////


/////////////////////////
//  BEGIN DEATH LOOP:  //
/////////////////////////

if dead 
    overhead "[ R.I.P. ]" 337
    wait 1500
    if EnableDeathLoop = 1
        while dead
            if timer "HEALERSEARCH" > 4000
                overhead "[ FIND A HEALER! ]" 0
                settimer "HEALERSEARCH" 0
            endif

            if findtype "blue moongate|30528|moongate" ground -1 -1 12 as EscapeGate
                if timer "GATEHERE" > 2000
                    overhead " ¼ " 253 EscapeGate
                    settimer "GATEHERE" 0
                endif
            endif

            while not gumpexists 3773199800 and findtype "blue moongate|30528|moongate" ground 0 1 2 as EscapeGate
                dclick EscapeGate
                wait 500
            endwhile

            while gumpexists 3773199800
                gumpresponse 16
                wait 500
                waitforgump 3773199800
                gumpresponse 2
                overhead "[ GATING TO TOWN... ]" 88
                break
            endwhile

            while gumpexists 2957810225
                overhead "[ HEALED! ]" 84
                gumpresponse 1
                wait 1000
                gumpclose 2957810225
                while not dead and not hidden and EnableHideAfterResurrection = 1
                    if targetexists
                        hotkey 'Cancel Current Target'
                    endif
                    wait 500
                    useskill 'Hiding'
                    wait 500
                    if hidden
                        break
                    endif
                endwhile
                break
            endwhile

            if not dead
               break
            endif
        endwhile
    else 
        wait 1000
        overhead "[ STOPPING SCRIPT! ]" 88
        stop     
    endif
endif

if not dead
    if EnableDressAfterResurrection = 1
        if EnableOverheadMessages = 1
            overhead '[ DRESSING... ]' 1790
        endif
        wait 500
        dress 'UltimateBackstabber'
        wait 500
        while queued
            wait 100
        endwhile
        wait 1000
        dress 'UltimateBackstabber'
        while queued
            wait 100
        endwhile
        wait 1000
        dress 'UltimateBackstabber'
        while queued
            wait 100
        endwhile
    endif
    wait 1000
    overhead "[ STOPPING SCRIPT! ]" 88
    stop
else 
    replay
endif 

//////////////////////
//  END DEATH LOOP  //
//////////////////////






