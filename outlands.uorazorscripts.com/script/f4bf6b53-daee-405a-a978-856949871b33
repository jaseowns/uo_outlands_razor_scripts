## Script: Train Veterinary using magical wizard hat
## Created by: .phisn#0
#############################################

# Train Veterinary using magical wizard hat by Chinga
# Required: Magical Wizard Hat (Mage NPC) & 15-20k Veterinary Supplies
#           Shelter dungeon for fast gain to 80, anywhere thereafter
#           ~12 hours to 100, ~12 hours to 120
# Credit to Tranq & Jaseowns for their healing concept
#
# Adjust your desired skill level on next line

while skill "veterinary" < 120
if not findtype 5912 self
    overhead "No magical wizard hat!" 20
    wait 5000
    stop
elseif not findtype 25750 backpack
    overhead "No Vet Supplies!" 20
    wait 5000
    stop
endif

if hp = maxhp and findlayer self head as wizardhat
    dclick wizardhat
    wait 650
elseif findtype 5912 backpack as wizardhat
    dclick wizardhat
    wait 650
endif

if not bandaging and hp < maxhp
    if findtype "veterinary supplies" backpack as vsupply
        clearsysmsg 
        while queued
            //donothing
        endwhile
        dclick vsupply
    endif
    wait 650

    while bandaging
        wait 650
        if hp = maxhp
            if findlayer self head as wizardhat
                dclick wizardhat
            elseif findtype 5912 backpack as wizardhat
                dclick wizardhat
            endif
        endif
    endwhile
endif
endwhile