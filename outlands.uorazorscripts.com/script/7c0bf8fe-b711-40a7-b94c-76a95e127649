# Bapeths Curepot + Cleansing Brew Hotkey
#
# "What it does:"
# Uses cure potion when poisoned
# If user is on Panacea cooldown and is bleeding or diseased it uses a Cleansing Brew
# If user does not have Panacea perk and is bleeding or diseased it uses a Cleansing Brew
#
# "REQUIRED"
#
# Cooldown Required "Panacea" 
# Trigger Text "Potion codex Panacea upgrade used."
# Cooldown "30" (Edit this in your in-game cooldowns options to match your Panacea Perk)

# Cooldown Required "Cleansing Brew" 
# Trigger Text "You drink a cleansing brew"
# Cooldown "120"

if poisoned and findtype "orange potion" backpack as baporange
    while queued
        //dn
    endwhile
    dclick baporange
elseif findbuff "Bleed" and not cooldown "Panacea" and findtype "orange potion" backpack as baporange
    while queued
        //dn
    endwhile    
    dclick baporange
    getlabel backpack ping
    if cooldown "Panacea"
        overhead "*Panacea Used*" 48
        stop
    endif
elseif findbuff "Diseased" and not cooldown "Panacea" and findtype "orange potion" backpack as baporange
    while queued
        //dn
    endwhile
    dclick baporange
    getlabel backpack ping
    if cooldown "Panacea"
        overhead "*Panacea Used*" 48
        stop
    endif
endif

if findbuff "Bleed" and not cooldown "Cleansing Brew" and findtype 50675 backpack as bapbrew
    while queued
        //dn
    endwhile
    dclick bapbrew
    overhead "*Brew Used*" 85
elseif findbuff "Diseased" and not cooldown "Cleansing Brew" and findtype 50675 backpack as bapbrew
    while queued
        //dn
    endwhile
    dclick bapbrew
    overhead "*Brew Used*" 85
endif