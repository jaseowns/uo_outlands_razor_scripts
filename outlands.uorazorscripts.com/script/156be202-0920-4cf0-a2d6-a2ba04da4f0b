                    if EnableOverheadMessages = 1
                    overhead '[ SLOW!]' 44
                    else
                        overhead ' Ï ' 44
                    endif
                    settimer NoTargetTimer 0
                    @setvar! Stealthing 1
                elseif insysmsg 'You have 3 stealth steps remaining.' and hidden
                    if EnableOverheadMessages = 1
                        overhead '[ SLOW ]' 153
                    else
                        overhead ' Ï ' 153
                    endif
                    settimer NoTargetTimer 0
                    @setvar! Stealthing 1
                endif
            endif
        endif
            
        if Stealthing = 1
            if timer FindTargetTimer > 500
                hotkey "Target Closest Grey Monster"
                getlabel backpack backpacklabel
                wait 100
                if insysmsg "no one matching"
                    if timer NoTargetTimer > 3200
                        if EnableOverheadMessages = 1
                            overhead "[ NOTHING TO TARGET... ]" 2338
                        endif
                        settimer NoTargetTimer 0
