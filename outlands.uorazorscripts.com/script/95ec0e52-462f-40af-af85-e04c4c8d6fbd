## Script: Ship Auto Repair (Hull / Sails / Guns)
## Created by: backbone_nd#0
#############################################

@setvar! done 0
while done = 0
    @clearsysmsg
    say '[repairhull'
    getlabel backpack pingcheck
    if insysmsg "hull does not need"
        @setvar! done 1
    else
        waitforsysmsg "Hull repaired" 15000
        getlabel backpack pingcheck
    endif
endwhile

@setvar! done 0
while done = 0
    @clearsysmsg
    say '[repairsails'
    getlabel backpack pingcheck
    if insysmsg "sails do not need"
        @setvar! done 1
    else
        waitforsysmsg "Sails repaired" 15000
        getlabel backpack pingcheck
    endif
endwhile

@setvar! done 0
while done = 0
    @clearsysmsg
    say '[repairguns'
    getlabel backpack pingcheck
    if insysmsg "guns do not need"
        @setvar! done 1
    else
        waitforsysmsg "Guns repaired" 15000
        getlabel backpack pingcheck
    endif
endwhile