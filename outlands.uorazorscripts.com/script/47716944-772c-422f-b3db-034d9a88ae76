                                        overhead '[ NO CURE POTS! ]' 337
                                        settimer 'CurePotionMessageTimer' 0
                                    endif
                                    break
                                endif
                            endwhile
                        endif

                        if EnableHealPotion = 1 and diffhits >= HealPotionHPdiff and casting and not targetexists
