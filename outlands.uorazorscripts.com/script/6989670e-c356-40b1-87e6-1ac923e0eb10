## Script: Herding and Vet 
## Created by: scottie2hottie69#0
#############################################

# Train Veterinary using magical wizard hat by Chinga
# Modified to use Shepherd's Crook every 3 seconds
#
# Shepherd's Crook:
# ID: 3713
# Hue: 2207
#
# Veterinary target: 120

############################
# SETTINGS
############################

@setvar! crookCooldown 3000

if not timerexists crookTimer
    settimer crookTimer crookCooldown
endif


############################
# MAIN LOOP
############################

while skill "veterinary" < 120

    ############################
    # USE CROOK
    ############################

    if timer crookTimer >= crookCooldown
        if findtype 3713 backpack 2207 as shepherdCrook
            dclick shepherdCrook
            settimer crookTimer 0
        endif
    endif


    ############################
    # CHECK REQUIRED ITEMS
    ############################

    if not findtype 5912 self
        overhead "No magical wizard hat!" 20
        wait 5000
        stop

    elseif not findtype 25750 backpack
        overhead "No Vet Supplies!" 20
        wait 5000
        stop
    endif


    ############################
    # USE WIZARD HAT
    ############################

    if hp = maxhp and findlayer self head as wizardhat
        dclick wizardhat
        wait 650

    elseif findtype 5912 backpack as wizardhat
        dclick wizardhat
        wait 650
    endif


    ############################
    # START VETERINARY BANDAGE
    ############################

    if not bandaging and hp < maxhp

        if findtype "veterinary supplies" backpack as vsupply
            clearsysmsg

            while queued

                # Check crook while waiting
                if timer crookTimer >= crookCooldown
                    if findtype 3713 backpack 2207 as shepherdCrook
                        dclick shepherdCrook
                        settimer crookTimer 0
                    endif
                endif

                wait 100

            endwhile

            dclick vsupply
        endif

        wait 650


        ############################
        # WHILE BANDAGING
        ############################

        while bandaging

            ############################
            # CHECK CROOK EVERY 3 SEC
            ############################

            if timer crookTimer >= crookCooldown
                if findtype 3713 backpack 2207 as shepherdCrook
                    dclick shepherdCrook
                    settimer crookTimer 0
                endif
            endif


            ############################
            # WIZARD HAT
            ############################

            if hp = maxhp

                if findlayer self head as wizardhat
                    dclick wizardhat

                elseif findtype 5912 backpack as wizardhat
                    dclick wizardhat
                endif

            endif

            # Short wait so crook timer is
            # checked frequently
            wait 100

        endwhile

    endif

    # Prevent unnecessary rapid looping
    wait 100

endwhile


############################
# FINISHED
############################

overhead "Veterinary reached 120!" 88