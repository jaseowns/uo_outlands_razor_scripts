                            clearsysmsg 
                            target ClosestTarget
                            wait 250

                            if insysmsg "seconds before you may use that ability again."
                                settimer PoisonStrikeTimer 28000
                                clearsysmsg 
                                break
                            elseif insysmsg "You do not have a Spell-based poison or disease effect on that target."
                                settimer PoisonStrikeTimer 15000
                                clearsysmsg 
                                break
                            else
                                break
                            endif
