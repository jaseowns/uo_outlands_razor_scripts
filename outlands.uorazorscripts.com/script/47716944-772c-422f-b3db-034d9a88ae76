                        else
                            overhead " „ " 337
                        endif
                        wait 1500
                        overhead '[ STOPPING SCRIPT! ]' 88
                        stop
                    endif
                endif
            endif  
        
            if diffhits > CastGreaterHealHPdiff or paralyzed
                break
            endif

            if mana > CastSmallSpellsBelowMana
                break
            endif 

