# Bank or Enter Inn Room or Exit to House Steward by Chinga
#
# Edit the serial of your Inn room door on line 10 (open chat, enter >info and target door)

if gumpexists 2393832411
gumpclose 2393832411
endif

# Exit Inn room to House Steward automatically or keep gump open to exit to town manually
if find 0x4DB08F02 ground as innroomdoor
    dclick innroomdoor
    waitforgump 2393832411
    gumpresponse 6
    stop
endif

# Enter your Inn Room routine: from NPC in town or from House Steward
say 'Guards! Bank Room Vas Rel Por' 88
waitforgump 2393832411 500
if ingump "Enter Your Room" 2393832411
    gumpresponse 4 2393832411
elseif ingump "Rent This Room" 2393832411
    gumpresponse 5 2393832411
    waitforgump 2393832411 500
    gumpresponse 100 2393832411
elseif ingump "Visit Other Rooms"
    gumpresponse 2 2393832411
    waitforgump 2393832411
    gumpresponse 100 2393832411 // 100 is 1st room in list, 101 is 2nd, etc. Change this if you have many rooms and your preferred room is not 1st in list
    gumpresponse 100 2393832411 // 100 is 1st room, 101 is 2nd, etc
endif